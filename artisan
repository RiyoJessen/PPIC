#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

// Autoload classes
spl_autoload_register(function (string $class): void {
    $prefix = 'App\\';
    $baseDir = __DIR__ . DIRECTORY_SEPARATOR . 'app' . DIRECTORY_SEPARATOR;

    $len = strlen($prefix);
    if (strncmp($prefix, $class, $len) !== 0) {
        return;
    }

    $relativeClass = substr($class, $len);
    $file = $baseDir . str_replace('\\', DIRECTORY_SEPARATOR, $relativeClass) . '.php';

    if (file_exists($file)) {
        require $file;
    }
});

\App\Config\AppConfig::loadEnv(__DIR__ . DIRECTORY_SEPARATOR . '.env');

$command = $argv[1] ?? 'help';

echo "\033[36m===============================================================\033[0m\n";
echo "\033[1;32m  PPIC PT DUNIA KIMIA JAYA GRESIK — CLI TOOL (ARTISAN)  \033[0m\n";
echo "\033[36m===============================================================\033[0m\n";

switch ($command) {
    case 'serve':
        $host = '127.0.0.1';
        $port = 8000;
        foreach ($argv as $arg) {
            if (str_starts_with($arg, '--port=')) {
                $port = (int) substr($arg, 7);
            }
            if (str_starts_with($arg, '--host=')) {
                $host = substr($arg, 7);
            }
        }
        echo "\033[32mINFO\033[0m  Server running on [\033[1;34mhttp://{$host}:{$port}\033[0m].\n";
        echo "Press Ctrl+C to stop the server\n\n";

        passthru("php -S {$host}:{$port} -t public");
        break;

    case 'migrate':
        echo "Running database migrations for PPIC...\n";
        \App\Database\Migration::run();
        echo "\033[32mMigration complete successfully.\033[0m\n";
        break;

    case 'db:seed':
        echo "Seeding default data (Materials, Products, BOMs, Suppliers)...\n";
        \App\Database\Seeder::run();
        echo "\033[32mDatabase seeding completed successfully.\033[0m\n";
        break;

    case 'migrate:fresh':
        echo "Refreshing database and clearing all business data...\n";
        \App\Database\Migration::run();
        \App\Database\Seeder::wipeAllBusinessData();
        echo "\033[32mDatabase wiped clean (ready for actual data).\033[0m\n";
        break;

    case 'route:list':
        echo "\nListing Registered PPIC Routes:\n";
        echo "-------------------------------------------------------------------------------------------------\n";
        printf("%-8s %-35s %-35s %-15s\n", "Method", "URI", "Action", "Division");
        echo "-------------------------------------------------------------------------------------------------\n";
        $routes = [
            ['GET', '/', 'DashboardController@index', 'PUBLIC'],
            ['GET', '/forecast-sales', 'SalesForecastController@index', 'PPIC'],
            ['POST', '/forecast-sales/generate', 'SalesForecastController@generateForecast', 'PPIC'],
            ['GET', '/ai/forecast', 'AiForecastingController@index', 'PPIC'],
            ['POST', '/ai/price-history/store', 'AiForecastingController@storeMarketPrice', 'PPIC'],
            ['GET', '/master/products', 'MasterController@products', 'RD'],
            ['GET', '/master/boms', 'MasterController@boms', 'RD'],
            ['GET', '/master/boms/ai-advisor', 'MasterController@aiFormulationAdvisor', 'RD'],
            ['GET', '/master/materials', 'MasterController@materials', 'RD'],
            ['GET', '/master/suppliers', 'MasterController@suppliers', 'PPIC'],
            ['GET', '/settings', 'SettingsController@index', 'Super Admin'],
        ];
        foreach ($routes as $r) {
            printf("%-8s %-35s %-35s %-15s\n", $r[0], $r[1], $r[2], $r[3]);
        }
        echo "-------------------------------------------------------------------------------------------------\n";
        break;

    case 'view:clear':
        $dir = __DIR__ . '/storage/framework/views';
        $files = glob($dir . '/*.php');
        foreach ($files as $f) {
            unlink($f);
        }
        echo "\033[32mCompiled views cleared successfully.\033[0m\n";
        break;

    case 'cache:clear':
        $dir = __DIR__ . '/storage/framework/cache';
        $files = glob($dir . '/*');
        foreach ($files as $f) {
            if (is_file($f) && basename($f) !== '.gitignore') unlink($f);
        }
        echo "\033[32mApplication cache cleared successfully.\033[0m\n";
        break;

    case 'list':
    case 'help':
    default:
        echo "Available Artisan Commands:\n";
        echo "  \033[33mserve\033[0m            Serve the application on the PHP development server\n";
        echo "  \033[33mmigrate\033[0m          Run the database migrations\n";
        echo "  \033[33mmigrate:fresh\033[0m    Drop all tables and re-run all migrations\n";
        echo "  \033[33mdb:seed\033[0m          Seed the database with records\n";
        echo "  \033[33mroute:list\033[0m       List all registered routes\n";
        echo "  \033[33mview:clear\033[0m       Clear all compiled view files\n";
        echo "  \033[33mcache:clear\033[0m      Clear application cache\n";
        break;
}
